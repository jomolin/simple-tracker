{
  "manifest_version": 3,
  "name": "Simple Student Tracker",
  "version": "1.0.0",
  "description": "Round-robin student selection with simple correct/incorrect tracking",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "sidePanel"
  ],
  "action": {
    "default_title": "Simple Student Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "commands": {
    "select-student": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Select next student (counts as correct if one is already on screen)",
      "global": true
    },
    "mark-incorrect": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "Mark current student incorrect / no answer",
      "global": true
    },
    "mark-absent": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Mark current student absent for today",
      "global": true
    },
    "toggle-grade-filter": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Cycle grade filter: All / Year 4 / Year 5",
      "global": true
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
